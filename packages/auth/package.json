{
  "name": "@tapedb/auth",
  "version": "0.4.2",
  "description": "Better Auth adapter for tapedb: users, sessions and members in a dedicated auth Durable Object.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "main": "index.mjs",
  "types": "index.d.ts",
