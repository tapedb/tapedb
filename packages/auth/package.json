    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@tapedb/tapedb": "0.4.2"
  },
  "peerDependencies": {
    "better-auth": "^1.7.25"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapedb/tapedb.git",
    "directory": "packages/auth"
  },
  "homepage": "https://tapedb.dev"
