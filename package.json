{
  "name": "@tapedb/tapedb",
  "version": "0.2.3",
  "description": "A log-structured database for Cloudflare Durable Objects. One SQLite database per workspace, transactions appended to a tape, replayed from R2 on cold start, with live queries and an offline-capable client.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://tapedb.dev",
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapedb/tapedb.git"
  },
  "bugs": {
    "url": "https://github.com/tapedb/tapedb/issues"
  },
  "keywords": [
    "cloudflare",
    "durable-objects",
    "database",
    "sqlite",
    "realtime",
    "offline-first",
    "sync"
  ],
  "files": [
    "dist",
    "assets/fonts/OFL.txt",
    "README.md",
    "API.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LIMITATIONS.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "import": "./dist/studio.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js"
    }
  },
  "bin": {
    "tapedb": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/types",
    "verify": "bun run typecheck && bun test && bun run test:auth && bun run test:docs && bun run build && bun run test:package",
    "test:docs": "node scripts/check-docs.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test": "bun test test",
    "api:update": "bun scripts/api-surface.ts --write",
    "test:e2e": "node scripts/e2e.mjs",
    "test:browser": "playwright test --config scripts/browser/playwright.config.ts",
    "test:auth": "vitest run --config scripts/auth/vitest.config.ts",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "better-auth": "^1.7.25"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-auth/test-utils": "1.7.25",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.65.1",
    "@react-native-async-storage/async-storage": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^13.0.2",
    "async-storage-v3": "npm:@react-native-async-storage/async-storage@^3",
    "better-auth": "1.7.25",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.8",
    "miniflare": "5.20261117.0-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
